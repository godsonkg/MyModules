#!name=节点 IP 质量检测（Surge）
#!desc=检测指定节点或策略组的出口 IP 类型、归属和风险，顺带看流媒体和 AI 能不能用。点首页面板运行；policy 要和 Surge 里的名字完全一致。
#!author=godsonkg
#!homepage=https://github.com/godsonkg/MyModules
#!icon=shield.lefthalf.filled
#!category=Tools
#!arguments=policy:PROXY,media:true,mask:false
#!arguments-desc=policy：要检测的节点或策略组名，区分大小写\nmedia：是否检测流媒体和 AI（true/false）\nmask：出口 IP 是否打码（true/false）

# 启用后首页会出现“节点 IP 质量检测”面板，点一下就开始检测，不会自动刷新。

[Panel]
节点IP质量检测 = script-name=ipquality,title="节点 IP 质量检测",content="点按开始检测"

[Script]
ipquality = type=generic,timeout=45,script-path=https://raw.githubusercontent.com/godsonkg/MyModules/main/Scripts/ipquality_surge.js,argument="policy={{{policy}}}&media={{{media}}}&mask={{{mask}}}",script-update-interval=0
