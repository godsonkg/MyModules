#!name=番茄小说去广告（增强版）
#!desc=2026.09.25-r8 · 广告/直播/SDK/上报域名拦截 + 素材重写；影响抖音等字节系 App
#!system=ios

# 需要 Surge iOS 5.9.1+。与轻量版二选一，已包含轻量版全部规则。
# 域名规则无需 MITM，是本模块的主体；HTTPS 路径重写仅在对应连接成功解密时生效。
# 域名清单对照 kelee（2026-06-01）、zirawell（2026-04-15）、zqzess/honue 番茄模块。
# 规则作用于整台设备：抖音、今日头条等字节系 App 的直播、小游戏、特效可能受影响。
# MITM 不含视频 CDN、*.snssdk.com、*.byteimg.com（r5/r6 实测客户端拒绝证书）。
# 本机自检：http://fanqie-check.invalid/?v=r8（必须使用 http）

[Rule]
# —— 广告接口与素材（同轻量版）——
DOMAIN-WILDCARD,ads*-normal*.zijieapi.com,REJECT,extended-matching
DOMAIN-WILDCARD,p*-ad-sign.byteimg.com,REJECT,extended-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT,extended-matching
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT,extended-matching
DOMAIN,zlink.ugsdk.cn,REJECT,extended-matching
DOMAIN,dig.bdurl.net,REJECT,extended-matching

# —— 阅读页直播卡片 ——
DOMAIN,content-open.douyin.com,REJECT,extended-matching
DOMAIN,webcast-open.douyin.com,REJECT,extended-matching
DOMAIN-WILDCARD,p*-webcast-sign.douyinpic.com,REJECT,extended-matching
DOMAIN,lf-webcast-gr-sourcecdn.bytegecko.com,REJECT,extended-matching

# —— 广告模板、实验配置与动态资源下发 ——
DOMAIN,lf-normal-gr-sourcecdn.bytegecko.com,REJECT,extended-matching
DOMAIN,gecko3.zijieapi.com,REJECT,extended-matching
DOMAIN,gecko5.zijieapi.com,REJECT,extended-matching
DOMAIN,abtest3-misc.zijieapi.com,REJECT,extended-matching
DOMAIN,p3-developer.bytemaimg.com,REJECT,extended-matching

# —— 字节 SDK（福利、小游戏、特效、风控）——
DOMAIN,i.snssdk.com,REJECT,extended-matching
DOMAIN,is.snssdk.com,REJECT,extended-matching
DOMAIN,is-lq.snssdk.com,REJECT,extended-matching
DOMAIN,vas.snssdk.com,REJECT,extended-matching
DOMAIN,effect.snssdk.com,REJECT,extended-matching
DOMAIN,security.snssdk.com,REJECT,extended-matching
DOMAIN,ma.zijieapi.com,REJECT,extended-matching
DOMAIN,minigame3-normal.zijieapi.com,REJECT,extended-matching
DOMAIN,minigame5-normal.zijieapi.com,REJECT,extended-matching
DOMAIN,mssdk.zijieapi.com,REJECT,extended-matching
DOMAIN,timon.zijieapi.com,REJECT,extended-matching
DOMAIN,vcs.zijieapi.com,REJECT,extended-matching
DOMAIN,feedback-c.zijieapi.com,REJECT,extended-matching

# —— 番茄日志与性能上报 ——
DOMAIN-WILDCARD,*-applog.fqnovel.com,REJECT,extended-matching
DOMAIN-WILDCARD,mon*-misc*.fqnovel.com,REJECT,extended-matching
DOMAIN,mon.toutiaocloud.com,REJECT,extended-matching
DOMAIN,mon.toutiaocloud.net,REJECT,extended-matching

[URL Rewrite]
# 源：zqzess FanQieNovel（SHA 9307684c）；pangolin/pglstatp 已整域拦截，对应重写删除
^https?://.+\.pstatp\.com/(obj|img)/(ad-app-package|ad|ad-site-adstyle-public)/.+ _ reject
^https?://.+\.pstatp\.com/(obj|img)/web\.business\.image/.+ _ reject
^https?://.+\.pstatp\.com/obj/ad-pattern/renderer _ reject
^https?://.+\.pstatp\.com/(ad-app-package|ad)/.+ _ reject
^https?://.+\.pstatp\.com/obj/mosaic-legacy/.+\?from\=ad _ reject
^https?://.+\.pstatp\.com/bytecom/resource/track_log/src/.+ _ reject
^https?://gurd\.snssdk\.com/src/server/v\d/package _ reject
^https?://.+\.snssdk\.com/video/play/1/toutiao/.+/mp4 _ reject
^https?://.+\.snssdk\.com/api/ad/.+ _ reject
^https?://.+\.byteimg\.com/tos-cn-i-1yzifmftcy/(.+)-jpeg\.jpeg _ reject
^http://.+\.byteimg\.com/ad-app-package _ reject
^http://.+\.byteimg\.com/web\.business\.image _ reject
^https?://adim\.pinduoduo\.com/.+/toutiao\?.+ _ reject

[Map Local]
# 仅检查模块加载及重写，不检查 MITM 或广告命中；响应在本机生成
^http://fanqie-check\.invalid(?::80)?/(?:\?[^#]*)?$ data-type=text data="番茄增强版 2026.09.25-r8 已加载；本机重写生效。广告是否消失请以请求记录中的 REJECT 为准。" status-code=200 header="Content-Type:text/plain; charset=utf-8|Cache-Control:no-store"

[MITM]
hostname = %APPEND% reading-hl.snssdk.com,i-hl.snssdk.com,gurd.snssdk.com,*.pstatp.com,adim.pinduoduo.com
