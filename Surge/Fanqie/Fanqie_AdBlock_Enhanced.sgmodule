#!name=番茄小说去广告（增强版）
#!desc=2026.09.25-r6 · 撤回视频 CDN 解密，处理连续 TLS 失败；阅读广告尚未解决
#!system=ios

# 源：https://github.com/zqzess/rule_for_quantumultX/blob/master/QuantumultX/rewrite/FanQieNovel.qxrewrite
# 源文件快照：9307684c73c474be442e602d5f55d5ba05633518
# 需要 Surge iOS 5.9.1+。HTTPS 路径仅在对应连接成功解密时生效。
# r5 已撤回 *.snssdk.com / *.byteimg.com；r6 再撤回 *novelapp.fqnovelvod.com。
# 手机记录确认视频 CDN 解密后客户端断开；删除对应视频路径重写，不封禁整个视频 CDN。
# 作用于整台设备，可能影响其他 App 的图片、视频或连接。
# 本机自检：http://fanqie-check.invalid/?v=r6（必须使用 http）

[Rule]
DOMAIN-WILDCARD,ads*-normal*.zijieapi.com,REJECT,extended-matching
DOMAIN,p6-ad-sign.byteimg.com,REJECT,extended-matching
DOMAIN,p9-ad-sign.byteimg.com,REJECT,extended-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT,extended-matching
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT,extended-matching

[URL Rewrite]
^https?://.+\.pangolin-sdk-toutiao\.com/api/ad/union/sdk/(get_ads|stats|settings)/ _ reject
^https?://.+\.pglstatp-toutiao\.com/.+/toutiao\.mp4 _ reject
^https?://.+\.(pglstatp-toutiao|pstatp)\.com/(obj|img)/(ad-app-package|ad)/.+ _ reject
^https?://.+\.(pglstatp-toutiao|pstatp)\.com/(obj|img)/web\.business\.image/.+ _ reject
^https?://.+\.(pglstatp-toutiao|pstatp)\.com/obj/ad-pattern/renderer _ reject
^https?://gurd\.snssdk\.com/src/server/v3/package _ reject
^https?://.+\.byteimg\.com/tos-cn-i-1yzifmftcy/(.+)-jpeg\.jpeg _ reject
^https?://.+\.pstatp\.com/obj/mosaic-legacy/.+\?from\=ad _ reject
^https?://.+\.pstatp\.com/bytecom/resource/track_log/src/.+ _ reject
^https?://.+\.snssdk\.com/video/play/1/toutiao/.+/mp4 _ reject
^https?://.+\.snssdk\.com/api/ad/.+ _ reject
^http://.+\.byteimg\.com/ad-app-package _ reject
^http://.+\.byteimg\.com/web\.business\.image _ reject
^https?://.+\.(pglstatp-toutiao|pstatp)\.com/(ad-app-package|ad)/.+ _ reject
^https?://adim\.pinduoduo\.com/.+/toutiao\?.+ _ reject

[Map Local]
# 仅检查模块加载及重写，不检查 MITM 或广告命中；响应在本机生成
^http://fanqie-check\.invalid(?::80)?/(?:\?[^#]*)?$ data-type=text data="番茄增强版 2026.09.25-r6 已加载；本机重写生效。这不代表 MITM 已成功，也不代表广告已拦截。" status-code=200 header="Content-Type:text/plain; charset=utf-8|Cache-Control:no-store"

[MITM]
hostname = %APPEND% reading-hl.snssdk.com,i-hl.snssdk.com,gurd.snssdk.com,*.pstatp.com,adim.pinduoduo.com
