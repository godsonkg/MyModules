#!name=番茄小说去广告（增强版）
#!desc=2026.09.25-r8 · 广告域名拦截，加素材和接口重写，需要开 MITM。对整台设备生效。
#!system=ios

# 需要 Surge iOS 5.9.1+，开启重写和 MITM，并信任 Surge 证书。
# HTTPS 重写只对 MITM 列表里、并且解密成功的连接有效。
# 重写改自 zqzess/rule_for_quantumultX 的 FanQieNovel.qxrewrite（9307684c）。
# pangolin-sdk-toutiao.com、pglstatp-toutiao.com 整个域名已在 [Rule] 里拦截，不再单独写重写。
# 视频 CDN（*.snssdk.com、*.byteimg.com、*novelapp.fqnovelvod.com）解密会被客户端拒绝，不要加回 MITM。
# 自检：Safari 打开 http://fanqie-check.invalid/?v=r8（必须是 http）

[Rule]
DOMAIN-WILDCARD,ads*-normal*.zijieapi.com,REJECT,extended-matching
DOMAIN,p6-ad-sign.byteimg.com,REJECT,extended-matching
DOMAIN,p9-ad-sign.byteimg.com,REJECT,extended-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT,extended-matching
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT,extended-matching
# 直播入口和素材候选，参考 zirawell、可莉的番茄模块；会连带影响抖音直播
DOMAIN,content-open.douyin.com,REJECT,extended-matching
DOMAIN,webcast-open.douyin.com,REJECT,extended-matching
DOMAIN,lf-webcast-gr-sourcecdn.bytegecko.com,REJECT,extended-matching

[URL Rewrite]
^https?://.+\.pstatp\.com/(?:(?:obj|img)/)?(?:ad-app-package|ad)/.+ _ reject
^https?://.+\.pstatp\.com/(?:obj|img)/web\.business\.image/.+ _ reject
^https?://.+\.pstatp\.com/obj/ad-pattern/renderer _ reject
^https?://.+\.pstatp\.com/obj/mosaic-legacy/.+\?from=ad _ reject
^https?://.+\.pstatp\.com/bytecom/resource/track_log/src/.+ _ reject
^https?://gurd\.snssdk\.com/src/server/v3/package _ reject
^https?://.+\.snssdk\.com/video/play/1/toutiao/.+/mp4 _ reject
^https?://.+\.snssdk\.com/api/ad/.+ _ reject
^https?://.+\.byteimg\.com/tos-cn-i-1yzifmftcy/(.+)-jpeg\.jpeg _ reject
^http://.+\.byteimg\.com/(?:ad-app-package|web\.business\.image) _ reject
^https?://adim\.pinduoduo\.com/.+/toutiao\?.+ _ reject

[Map Local]
# 只说明模块已加载、本机重写在工作，不代表 MITM 成功或广告已拦住
^http://fanqie-check\.invalid(?::80)?/(?:\?[^#]*)?$ data-type=text data="番茄增强版 2026.09.25-r8 已加载，本机重写正常。广告有没有拦住，要看最近请求里的命中记录。" status-code=200 header="Content-Type:text/plain; charset=utf-8|Cache-Control:no-store"

[MITM]
hostname = %APPEND% reading-hl.snssdk.com,i-hl.snssdk.com,gurd.snssdk.com,*.pstatp.com,adim.pinduoduo.com
